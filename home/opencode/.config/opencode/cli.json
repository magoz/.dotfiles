{
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "leader": "ctrl+o",
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "input.delete.to.line.start": "none",
    "input.delete": "delete,shift+delete"
  },
  "plugins": [
    { "package": "./plugins/herdr-opencode" },
    { "package": "./plugins/dotfiles-tools" },
    { "package": "./plugins/worktree-manager" },
    { "package": "./plugins/subscription-usage" },
    {
      "package": "./plugins/opencode-vim-compat",
      "options": {
        "enabled": true,
        "vim_initial_mode": "normal",
        "vim_enter_submit": true,
        "indicator": true
      }
    }
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show"
  },
  "tabs": {
    "enabled": false
  },
  "animations": true
}
