{
  "theme": {
    "name": "tokyonight"
  },
  "keybinds": {
    "session.half.page.up": "ctrl+u",
    "session.half.page.down": "ctrl+d",
    "input.delete.to.line.start": "none",
    "input.delete": "delete,shift+delete"
  },
  "plugins": [
    { "package": "./plugins/herdr-opencode" },
    { "package": "./plugins/dotfiles-tools" },
    { "package": "./plugins/until" },
    { "package": "./plugins/worktree-manager" },
    { "package": "./plugins/subscription-usage" },
    "-ocv-plugin"
  ],
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show"
  },
  "tabs": {
    "enabled": false
  },
  "animations": true
}
