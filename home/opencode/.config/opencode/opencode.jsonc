{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  // Temporary until anomalyco/opencode#39541 ships. ChatGPT OAuth uses smaller
  // GPT-5.5/5.6 windows than the public API catalog. Provider overflow recovery
  // remains active with preflight compaction disabled.
  "compaction": {
    "auto": false,
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-5.5": { "limit": { "context": 400000, "input": 272000, "output": 128000 } },
        "gpt-5.5-fast": { "limit": { "context": 400000, "input": 272000, "output": 128000 } },
        "gpt-5.6-sol": { "limit": { "context": 500000, "input": 372000, "output": 128000 } },
        "gpt-5.6-sol-fast": { "limit": { "context": 500000, "input": 372000, "output": 128000 } },
        "gpt-5.6-luna": { "limit": { "context": 500000, "input": 372000, "output": 128000 } },
        "gpt-5.6-luna-fast": { "limit": { "context": 500000, "input": 372000, "output": 128000 } },
        "gpt-5.6-terra": { "limit": { "context": 500000, "input": 372000, "output": 128000 } },
        "gpt-5.6-terra-fast": { "limit": { "context": 500000, "input": 372000, "output": 128000 } },
      },
    },
  },

  // Model
  // Qhy both? Opencode's server-side variant resolution (`session/prompt.ts:846-853`) only applies the agent's variant when `agent.model` exists AND matches the resolved model.
  // Without `model` on the agent, the variant is silently ignored.
  // The web UI may still show "Default" in the variant picker -- this is cosmetic. The server resolves `variant: "max"` via agent config fallback.
  // Verified by checking message data on machines: user messages contain `"variant": "max"`.
  "model": "openai/gpt-5.6-sol",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol",
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude.",
      "variant": "high",
    },
    "plan": {
      "model": "openai/gpt-5.6-sol",
      "prompt": "You are Claude Code, Anthropic's official CLI for Claude.",
      "variant": "high",
    },
  },

  "plugin": [
    "file:///Users/magoz/.config/opencode/plugins/opencode-anthropic-auth/index.mjs",
  ],
  "mcp": {
    "executor": {
      "type": "remote",
      "url": "https://executor.magoz.is/mcp",
      "enabled": true,
    },
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.example": "allow",
      "*.envrc": "deny",
      "secrets/*": "deny",
    },
    "skill": {
      "*": "allow",
      "figma-*": "deny",
      "figma": "allow",
    },
    "external_directory": {
      "/Users/magoz/dev/docs/*": "allow",
      "/Users/magoz/.agents/*": "allow",
      "/Users/magoz/.dotfiles/home/agents/*": "allow",
      "/Users/magoz/.dotfiles/home/opencode/*": "allow",
      "/Users/magoz/dev/core-projects/clients/init/*": "allow",
    },
  },
}
