{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  // Assessment baseline: native provider limits, native compaction, no Pi changes.
  "compaction": { "auto": true },
  "model": "subs-claude/claude-opus-5-5",
  "agents": {
    "build": { "model": "subs-claude/claude-opus-5-5#high" },
    "plan": { "model": "subs-claude/claude-opus-5-5#high" }
  },
  // Same CLIProxyAPI gateway (https://subs.oox.sh) as Pi's subs-codex (~/.pi/agent/models.json).
  // The key is a saved OpenCode account, never this file:
  //   opencode auth login subs-codex --method key   (paste the gateway key)
  "providers": {
    "subs-codex": {
      "name": "Subs Codex",
      "package": "@opencode/ai/providers/openai/responses",
      "settings": { "baseURL": "https://subs.oox.sh/v1" },
      // Mirrors the built-in openai catalog entries (capabilities, limits, variants).
      "models": {
        "gpt-6-astra": {
          "name": "GPT-6 Astra (Subs Codex Pool)",
          "family": "gpt-astra",
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 400000, "input": 272000, "output": 128000 },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "medium", "settings": { "reasoningEffort": "medium", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "high", "settings": { "reasoningEffort": "high", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "max", "settings": { "reasoningEffort": "max", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } }
          ]
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol (Subs Codex Pool)",
          "family": "gpt-sol",
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 400000, "input": 272000, "output": 128000 },
          "variants": [
            { "id": "low", "settings": { "reasoningEffort": "low", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "medium", "settings": { "reasoningEffort": "medium", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "high", "settings": { "reasoningEffort": "high", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "max", "settings": { "reasoningEffort": "max", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } }
          ]
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol (Subs Codex Pool)",
          "family": "gpt-sol",
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 400000, "input": 272000, "output": 128000 },
          "variants": [
            { "id": "none", "settings": { "reasoningEffort": "none", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "low", "settings": { "reasoningEffort": "low", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "medium", "settings": { "reasoningEffort": "medium", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "high", "settings": { "reasoningEffort": "high", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "xhigh", "settings": { "reasoningEffort": "xhigh", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } },
            { "id": "max", "settings": { "reasoningEffort": "max", "reasoningSummary": "auto", "include": ["reasoning.encrypted_content"] } }
          ]
        }
      }
    },
    // Same CLIProxyAPI Claude pool as Pi's subs-claude. Key is a saved account:
    //   opencode auth login subs-claude --method key   (paste the gateway key)
    // Fail closed: baseURL is an unreachable sentinel. The gateway plugin
    // (plugins/subs-claude-gateway) shapes each request, then re-targets it
    // to https://subs.oox.sh/v1; without the plugin requests fail, never go unshaped.
    "subs-claude": {
      "name": "Subs Claude",
      "package": "@opencode/ai/providers/anthropic",
      "settings": { "baseURL": "http://127.0.0.1:9/subs-claude-unshaped/v1" },
      // Mirrors the built-in anthropic catalog entry (models.dev effort values, adaptive thinking).
      "models": {
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5 (Subs Claude Pool)",
          "family": "claude-opus",
          "capabilities": { "tools": true, "input": ["text", "image", "pdf"], "output": ["text"] },
          "limit": { "context": 1000000, "output": 128000 },
          // High reasoning by default (root `model` cannot carry a #variant); variants override.
          "settings": { "thinking": { "type": "adaptive", "display": "summarized" }, "effort": "high" },
          "variants": [
            { "id": "low", "settings": { "thinking": { "type": "adaptive", "display": "summarized" }, "effort": "low" } },
            { "id": "medium", "settings": { "thinking": { "type": "adaptive", "display": "summarized" }, "effort": "medium" } },
            { "id": "high", "settings": { "thinking": { "type": "adaptive", "display": "summarized" }, "effort": "high" } },
            { "id": "xhigh", "settings": { "thinking": { "type": "adaptive", "display": "summarized" }, "effort": "xhigh" } },
            { "id": "max", "settings": { "thinking": { "type": "adaptive", "display": "summarized" }, "effort": "max" } }
          ]
        }
      }
    }
  },
  "plugins": [
    // subs-claude request shaping; without it subs-claude requests fail closed (sentinel baseURL).
    "./plugins/subs-claude-gateway",
    "./plugins/dotfiles-tools",
    // Background shell-condition watches and recurring wakes (pi-until parity). See plugins/until/README.md.
    "./plugins/until",
    "./plugins/herdr-opencode",
    // `/<id>` for shared skills flagged `metadata.opencode/slash: "true"`.
    "./plugins/skill-commands",
    "./plugins/subscription-usage",
    // Native worktree strategy `dotfiles`: provisioned sibling checkouts (worktree checkout),
    // Herdr-free retirement (worktree-manage). See plugins/worktrees/README.md.
    "./plugins/worktrees"
  ],
  "mcp": {
    "servers": {
      "executor": { "type": "remote", "url": "https://executor.magoz.is/mcp" },
      // Mobbin design refs (Pro plan). OAuth via `/mcps`. Prefer mode "standard"; "deep" costs AI credits.
      "mobbin": { "type": "remote", "url": "https://api.mobbin.com/mcp" }
    }
  },
  // YOLO like Pi: allow everything; later rules (last match wins) still deny secrets.
  // MCP tools (`<server>_<tool>`) are allowed here too; Executor's own server-side
  // policies (approve / require_approval / block) remain the gate via MCP elicitation.
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": ".env.example", "effect": "allow" },
    { "action": "read", "resource": "*.envrc", "effect": "deny" },
    { "action": "read", "resource": "secrets/*", "effect": "deny" },
    // Nested figma/skills/figma-* leaves are indexed by OpenCode's **/SKILL.md scan and
    // loadable by id despite disable-model-invocation; only the `figma` router may load them.
    { "action": "skill", "resource": "figma-*", "effect": "deny" }
  ]
}
