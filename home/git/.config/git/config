[user]
  name = magoz
  email = apps@magoz.is
[core]
  editor = nvim
[pull]
	ff = only
[init]
	defaultBranch = main

# `git push` new branches without `--set-upstream origin`
[credential]
        helper = osxkeychain

# `git push` new branches without `--set-upstream origin`
[push]
	autoSetupRemote = true

[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
