#!/usr/bin/env bash
set -euo pipefail

# Herdr popup commands inherit the server's environment, which may not include
# user or Homebrew paths when Herdr is launched directly by a terminal app.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
herdr_bin=${HERDR_BIN_PATH:-herdr}

if [[ $# -eq 1 ]]; then
  selected=$1
else
  selected=$(
    (
      find ~/dev/repos \
        -mindepth 1 -maxdepth 1 -type d 2>/dev/null || true
      find ~/.dotfiles \
        ~/aha \
        ~/collie \
        ~/subs \
        -mindepth 0 -maxdepth 0 -type d 2>/dev/null || true
    ) | fzf
  )
fi

if [[ -z ${selected:-} ]]; then
  exit 0
fi

selected=$(cd "$selected" && pwd -P)
selected_name=$(basename "$selected" | tr . _)

if [[ ${HERDR_ENV:-} == 1 ]]; then
  workspace_id=$("$herdr_bin" workspace list | jq -r \
    --arg label "$selected_name" \
    'first(.result.workspaces[]? | select(.label == $label) | .workspace_id) // empty')

  if [[ -n $workspace_id ]]; then
    "$herdr_bin" workspace focus "$workspace_id" >/dev/null
  else
    "$herdr_bin" workspace create --cwd "$selected" --label "$selected_name" --focus >/dev/null
  fi

  exit 0
fi

cd "$selected"
exec "$herdr_bin"
