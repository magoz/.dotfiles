#!/usr/bin/env bash
set -euo pipefail

completion_dir=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions
mkdir -p "$completion_dir"

write_completion() {
  local name=$1
  shift
  local target=$completion_dir/_$name
  local temporary

  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'warning: skipping %s completion; command not found: %s\n' "$name" "$1" >&2
    return 0
  fi

  temporary=$(mktemp "$completion_dir/.$name.XXXXXX")
  if "$@" >"$temporary" && [[ -s $temporary ]]; then
    if [[ ! -f $target ]] || ! cmp -s "$temporary" "$target"; then
      mv "$temporary" "$target"
    else
      rm "$temporary"
    fi
  else
    rm -f "$temporary"
    printf 'error: failed to generate %s completion\n' "$name" >&2
    return 1
  fi
}

write_completion herdr herdr completion zsh
# OpenCode 2 uses `opencode completion <shell>`; pre-2.0 used `--completions`.
if command -v opencode >/dev/null 2>&1 && opencode completion zsh >/dev/null 2>&1; then
  write_completion opencode opencode completion zsh
else
  write_completion opencode opencode --completions zsh
fi
# Drop the completion generated for the retired preview command.
rm -f "$completion_dir/_opencode2"
write_completion pnpm pnpm completion zsh
