#!/bin/bash

# set current directory, in case the script is called from another directory.
cd "$(dirname "$0")" || exit

# Disable Brew telemetry
brew analytics off

# --------------------------------------
# -----------  INSTALL APPS ------------
# --------------------------------------
echo "🍺 Installing apps with Homebrew"
brew install \
  keyboard-maestro \
  raycast \
  leader-key \
  istat-menus \
  bartender \
  appcleaner \
  postico \
  postman \
  medis \
  telegram \
  spotify \
  todoist \
  fontbase

# The workstation installer owns this. Running it here covers a machine that
# installs the app after the Stow package is already in place.
./install --configure-leader-key || exit 1
