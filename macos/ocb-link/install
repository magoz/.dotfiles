#!/usr/bin/env bash
# Build and register "OCB Link.app", the handler for ocb://session/<id> links
# (Fleet's "Open in terminal"). It opens a new Ghostty window running ocb.
# Idempotent; run by ./macos/setup-box.
set -euo pipefail

dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
app=${OCB_LINK_APP:-$HOME/Applications/OCB Link.app}
plistbuddy=${PLISTBUDDY:-/usr/libexec/PlistBuddy}
lsregister=${LSREGISTER:-/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister}

[[ $(uname -s) == Darwin ]] || { echo "ocb-link: macOS only" >&2; exit 2; }

mkdir -p "$(dirname "$app")"
rm -rf "$app"
osacompile -o "$app" "$dir/ocb-link.applescript"

plist=$app/Contents/Info.plist
"$plistbuddy" -c 'Set :CFBundleIdentifier is.magoz.ocb-link' "$plist" 2>/dev/null ||
  "$plistbuddy" -c 'Add :CFBundleIdentifier string is.magoz.ocb-link' "$plist"
"$plistbuddy" -c 'Add :LSUIElement bool true' "$plist" 2>/dev/null || true
"$plistbuddy" -c 'Delete :CFBundleURLTypes' "$plist" 2>/dev/null || true
"$plistbuddy" \
  -c 'Add :CFBundleURLTypes array' \
  -c 'Add :CFBundleURLTypes:0 dict' \
  -c 'Add :CFBundleURLTypes:0:CFBundleURLName string OpenCode on Box session' \
  -c 'Add :CFBundleURLTypes:0:CFBundleURLSchemes array' \
  -c 'Add :CFBundleURLTypes:0:CFBundleURLSchemes:0 string ocb' \
  "$plist"

# Editing Info.plist invalidates osacompile's ad-hoc signature; re-sign ad hoc.
codesign --force --deep --sign - "$app"
"$lsregister" -f "$app"
echo "ocb-link: registered ocb:// → $app"
