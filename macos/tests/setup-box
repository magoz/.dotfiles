#!/usr/bin/env bash
set -euo pipefail

MACOS_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
TEST_ROOT=$(mktemp -d)
trap 'rm -rf "$TEST_ROOT"' EXIT
mkdir -p "$TEST_ROOT/bin" "$TEST_ROOT/home"
export HOME=$TEST_ROOT/home
export CALLS=$TEST_ROOT/calls PROFILES=$TEST_ROOT/profiles
export PATH=$TEST_ROOT/bin:$PATH
unset HERDR_ENV SSH_CONNECTION SSH_TTY

cat >"$TEST_ROOT/bin/uname" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "${TEST_OS:-Darwin}"
EOF
cat >"$TEST_ROOT/bin/ssh" <<'EOF'
#!/usr/bin/env bash
printf 'ssh %s\n' "$*" >>"$CALLS"
case "$*" in
  *'jq -er .password'*) [[ -n ${PASSWORD_EXIT:-} ]] && exit "$PASSWORD_EXIT"; printf 'fake-secret\n' ;;
esac
exit "${SSH_EXIT:-0}"
EOF
cat >"$TEST_ROOT/bin/security" <<'EOF'
#!/usr/bin/env bash
case $1 in
  add-generic-password) printf 'security add %s\n' "${*: -1}" >>"$CALLS"; printf '%s' "${*: -1}" >"$TEST_ROOT/keychain" ;;
  find-generic-password) [[ -f $TEST_ROOT/keychain ]] && cat "$TEST_ROOT/keychain" ;;
  *) exit 92 ;;
esac
EOF
cat >"$TEST_ROOT/bin/curl" <<'EOF'
#!/usr/bin/env bash
printf 'curl %s\n' "$*" >>"$CALLS"
printf 'curl-stdin %s\n' "$(cat)" >>"$CALLS"
[[ -n ${CURL_EXIT:-} ]] && exit "$CURL_EXIT"
printf '{"version":"%s"}\n' "${SERVER_VERSION:-2.0.20}"
EOF
cat >"$TEST_ROOT/bin/opencode" <<'EOF'
#!/usr/bin/env bash
[[ $* == --version ]] && printf 'opencode v%s\n' "${CLIENT_VERSION:-2.0.20}"
EOF
cat >"$TEST_ROOT/bin/npm" <<'EOF'
#!/usr/bin/env bash
printf 'npm %s\n' "$*" >>"$CALLS"
EOF
cat >"$TEST_ROOT/bin/osacompile" <<'EOF'
#!/usr/bin/env bash
printf 'osacompile %s\n' "${*##*/}" >>"$CALLS"
mkdir -p "$2/Contents" && : >"$2/Contents/Info.plist"
EOF
cat >"$TEST_ROOT/bin/codesign" <<'EOF'
#!/usr/bin/env bash
printf 'codesign %s\n' "$*" >>"$CALLS"
EOF
cat >"$TEST_ROOT/bin/plistbuddy" <<'EOF'
#!/usr/bin/env bash
printf 'plistbuddy %s\n' "$*" >>"$CALLS"
EOF
cat >"$TEST_ROOT/bin/lsregister" <<'EOF'
#!/usr/bin/env bash
printf 'lsregister %s\n' "$*" >>"$CALLS"
EOF
export TEST_ROOT PLISTBUDDY=$TEST_ROOT/bin/plistbuddy LSREGISTER=$TEST_ROOT/bin/lsregister
cat >"$TEST_ROOT/bin/herdr" <<'EOF'
#!/usr/bin/env bash
printf 'herdr %s\n' "$*" >>"$CALLS"
case "$*" in
  'machine list --json') cat "$PROFILES" ;;
  'machine add box --label Box') exit "${ADD_EXIT:-0}" ;;
  'machine enable saved-id') ;;
  'config check') exit "${CONFIG_EXIT:-0}" ;;
  *) exit 91 ;;
esac
EOF
chmod +x "$TEST_ROOT/bin/"*

reset() { : >"$CALLS"; printf '[]\n' >"$PROFILES"; rm -f "$TEST_ROOT/keychain"; }
run_setup() { bash "$MACOS_DIR/setup-box" "$@" >"$TEST_ROOT/output" 2>&1; }
reject() { if run_setup "$@"; then printf 'expected setup failure\n' >&2; exit 1; fi; }
absent() { if grep "$@"; then printf 'unexpected command or output\n' >&2; exit 1; fi; }
no_mutation() { absent -Eq 'herdr machine (add|enable)' "$CALLS"; }

reset
run_setup --help
[[ ! -s $CALLS ]]
reject --unknown
TEST_OS=Linux reject
HERDR_ENV=1 reject
SSH_CONNECTION=remote reject
SSH_TTY=/dev/pts/1 reject
[[ ! -s $CALLS ]]
printf 'ok: Mac setup rejects unsupported/nested invocation without side effects\n'

reset
SSH_EXIT=255 reject
no_mutation
reset
CONFIG_EXIT=1 reject
no_mutation
for malformed in '' '{}' '[] []'; do
  reset
  printf '%s\n' "$malformed" >"$PROFILES"
  reject
  no_mutation
done
reset
printf '[{"id":"a"}]\n' >"$PROFILES"
reject
no_mutation
printf 'ok: failed SSH/config and malformed catalogs cannot change machines\n'

reset
run_setup
grep -Fxq 'ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10 box true' "$CALLS"
grep -Fxq 'herdr machine add box --label Box' "$CALLS"
absent -Eq -- '--handoff|server stop|StrictHostKeyChecking=no' "$CALLS"
reset
ADD_EXIT=1 reject
absent -Fq 'Run `herdr`' "$TEST_ROOT/output"
printf 'ok: new machine setup preserves SSH checks and Herdr approval/failure\n'

reset
printf '[{"id":"saved-id","label":"Build host","target":"box","session":"default","enabled":true}]\n' >"$PROFILES"
run_setup
run_setup
no_mutation
printf '[{"id":"saved-id","label":"Build host","target":"box","session":"default","enabled":false}]\n' >"$PROFILES"
run_setup
grep -Fxq 'herdr machine enable saved-id' "$CALLS"
absent -Fq 'herdr machine add' "$CALLS"
printf 'ok: existing profiles are reused by target/session, not derived IDs\n'

reset
printf '[{"id":"other","label":"Box","target":"other","session":"default","enabled":true}]\n' >"$PROFILES"
reject
no_mutation
reset
printf '[{"id":"a","label":"Box","target":"box","session":"named","enabled":true}]\n' >"$PROFILES"
reject
no_mutation
reset
printf '[{"id":"a","label":"A","target":"box","session":"default","enabled":true},{"id":"b","label":"B","target":"box","session":"default","enabled":true}]\n' >"$PROFILES"
reject
no_mutation
printf 'ok: label collisions and duplicate profiles require operator resolution\n'

reset
run_setup
grep -Fxq 'security add fake-secret' "$CALLS"
grep -Fxq 'curl -fsS --max-time 10 -K - https://box.tail129a86.ts.net:9446/api/info' "$CALLS"
grep -Fxq 'curl-stdin user = "opencode:fake-secret"' "$CALLS"
absent -Eq '^curl .*fake-secret' "$CALLS"
absent -Fq 'npm ' "$CALLS"
absent -Fq 'fake-secret' "$TEST_ROOT/output"
grep -Fq 'OpenCode client and Box server: 2.0.20' "$TEST_ROOT/output"
printf 'ok: ocb setup stores the password without exposing it and verifies the server\n'

grep -Eq '^osacompile -o .*OCB Link.app ocb-link.applescript$' "$CALLS"
grep -Fq 'CFBundleURLSchemes:0 string ocb' "$CALLS"
grep -Eq '^codesign --force --deep --sign - .*/Applications/OCB Link.app$' "$CALLS"
grep -Eq '^lsregister -f .*/Applications/OCB Link.app$' "$CALLS"
script=$MACOS_DIR/ocb-link/ocb-link.applescript
grep -Fq 'on open location theURL' "$script"
grep -Fq 'does not start with "ses_" then return' "$script"
grep -Fq 'quoted form of' "$script"
printf 'ok: the ocb:// handler is compiled, signed, registered and validates session ids\n'

reset
CLIENT_VERSION=2.0.19 run_setup
grep -Fxq 'npm install --global --allow-scripts=@opencode/cli @opencode/cli@2.0.20' "$CALLS"
reset
SERVER_VERSION='2.0.20; rm -rf ~' CLIENT_VERSION=2.0.19 reject
absent -Fq 'npm ' "$CALLS"
printf 'ok: the OpenCode client is aligned to the validated server version\n'

reset
PASSWORD_EXIT=1 reject
absent -Fq 'curl ' "$CALLS"
reset
CURL_EXIT=22 reject
absent -Fq 'npm ' "$CALLS"
absent -Fq 'Run `ocb`' "$TEST_ROOT/output"
printf 'ok: unreadable password or unreachable server stops setup before installing\n'
