#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd -P)
HOME_PACKAGES=$REPO_ROOT/home

install_tailscale_app() (
  local app_path=/Applications/Tailscale.app
  local formula_installed=false
  local cask_installed=false
  local install_pkg=false
  local package_url package_path expected_sha actual_sha temp_dir

  brew list --formula tailscale &>/dev/null && formula_installed=true
  brew list --cask tailscale-app &>/dev/null && cask_installed=true

  # Tailscale recommends its standalone macOS app. The Homebrew formula installs
  # CLI-only tailscaled, whose macOS DNS integration can miss split-DNS routes.
  if [[ ! -d $app_path || $cask_installed == true ]]; then
    install_pkg=true
    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' EXIT
    package_path=$temp_dir/Tailscale.pkg

    echo "🔒 Downloading the official Tailscale macOS app"
    package_url=$(curl -fsSL -o /dev/null -w '%{url_effective}' \
      https://pkgs.tailscale.com/stable/Tailscale-latest-macos.pkg)
    [[ $package_url == https://pkgs.tailscale.com/stable/Tailscale-*-macos.pkg ]] || {
      printf 'Unexpected Tailscale package URL: %s\n' "$package_url" >&2
      exit 1
    }

    curl -fsSL "$package_url" -o "$package_path"
    expected_sha=$(curl -fsSL "$package_url.sha256" | awk 'NR == 1 { print $1 }')
    actual_sha=$(shasum -a 256 "$package_path" | awk '{ print $1 }')
    [[ -n $expected_sha && $actual_sha == "$expected_sha" ]] || {
      printf 'Tailscale package checksum verification failed\n' >&2
      exit 1
    }
    pkgutil --check-signature "$package_path" >/dev/null
  fi

  if [[ $formula_installed == true ]]; then
    echo "🧹 Removing the conflicting Homebrew Tailscale formula"
    brew services stop tailscale >/dev/null 2>&1 || true
    sudo "$(command -v brew)" services stop tailscale >/dev/null 2>&1 || true
    brew uninstall --formula tailscale
  fi

  if [[ $cask_installed == true ]]; then
    echo "🧹 Moving Tailscale app ownership away from Homebrew"
    brew uninstall --cask tailscale-app
  fi

  if [[ $install_pkg == true ]]; then
    sudo installer -pkg "$package_path" -target /
  else
    echo "Tailscale native macOS app already installed, skipping"
  fi
)

# --------------------------------------
# ------ CLEANUP EXISTING CONF ---------
# --------------------------------------
rm -f ~/.gitconfig ~/.zprofile

# --------------------------------------
# ---------- INSTALL TAILSCALE ---------
# --------------------------------------
install_tailscale_app

# --------------------------------------
# -------- TRUST THIRD-PARTY TAPS ------
# --------------------------------------
# Treat taps already used on this machine as explicitly trusted sources.
brew trust --tap \
  anomalyco/tap \
  jnsahaj/lumen \
  libsql/sqld \
  ngrok/ngrok \
  nikitabobko/tap \
  oven-sh/bun \
  stripe/stripe-cli \
  tursodatabase/tap

# --------------------------------------
# ---------  INSTALL PACKAGES ----------
# --------------------------------------
echo "🍺 Installing basic config packages with Homebrew"
brew install \
  bat \
  bun \
  git \
  fnm \
  jq \
  ghostty \
  font-meslo-lg-nerd-font \
  neovim \
  nikitabobko/tap/aerospace \
  stow \
  herdr \
  zsh \
  eza \
  zoxide \
  fzf \
  starship \
  zsh-autosuggestions \
  zsh-syntax-highlighting \
  zsh-completions

# Node/npm are required for Pi, OpenCode, and local extension dependencies.
eval "$(fnm env --shell bash)"
fnm install --lts --use
fnm default "$(fnm current)"

export NPM_CONFIG_PREFIX="$HOME/.local/share/npm"
export PATH="$NPM_CONFIG_PREFIX/bin:$PATH"

# Install Pi before stowing its configuration.
echo "🥧 Installing Pi"
npm install -g --ignore-scripts @earendil-works/pi-coding-agent

# Borders
brew tap FelixKratz/formulae
brew trust --formula felixkratz/formulae/borders
brew install borders

# --------------------------------------
# --------------  STOW -----------------
# --------------------------------------
"$SCRIPT_DIR/stow"

# --------------------------------------
# -------- CONFIG DEPENDENCIES ----------
# --------------------------------------
echo "📦 Installing local script dependencies"
bun install --cwd "$HOME_PACKAGES/scripts/.local/share/sandbox-db"
bun install --cwd "$HOME_PACKAGES/scripts/.local/share/worktree"

echo "📦 Installing OpenCode dependencies"
bun install --ignore-scripts --cwd "$HOME_PACKAGES/opencode/.config/opencode"
bun "$HOME_PACKAGES/opencode/.config/opencode/scripts/install-plannotator.mjs"

npm ci --prefix "$HOME_PACKAGES/opencode/.config/opencode/plugins/opencode-anthropic-auth"
npm ci --prefix "$HOME_PACKAGES/opencode/.config/opencode/plugins/opencode-vim-compat"

echo "📦 Installing Pi extension dependencies"
# Extensions resolve from their real (stowed) source paths in this repo, so
# their shared node_modules must live beside the repo's package.json.
npm ci --omit=dev --prefix "$HOME_PACKAGES/pi/.pi"

# Install the pinned Pi packages declared by the stowed settings file.
echo "📦 Installing Pi packages"
while IFS= read -r package; do
  if [[ $package == git:github.com/joelhooks/pi-until@* ]]; then
    # Upstream's exact devEngines npm pin rejects newer compatible npm 11.x.
    NPM_CONFIG_FORCE=true pi install "$package"
  else
    pi install "$package"
  fi
done < <(jq -r '.packages[] | if type == "string" then . else .source end' "$HOME/.pi/agent/settings.json")

# --------------------------------------
# --------------  ZSH ------------------
# --------------------------------------
# Force Zsh to rebuild completions with the stowed configuration on next launch.
rm -f "$HOME/.zcompdump" "$HOME/.config/zsh/.zcompdump"*

# --------------------------------------
# -------------  NEOVIM ----------------
# --------------------------------------
# Plugins dependencies
# telescope uses fd and ripgrep

echo "⚡ Setting up Neovim"
brew install \
  fd \
  lazygit \
  ripgrep \
  tree-sitter-cli

# Install plugins
nvim --headless "+Lazy! sync" +qa

# --------------------------------------
# ------------- BORDERS ----------------
# --------------------------------------
brew services restart borders

# --------------------------------------
# ------  INSTALL DEV PACKAGES ---------
# --------------------------------------
# tlrc is tldr
echo "🚀 Installing DEV packages with Homebrew"
brew install \
  tlrc

# pnpm (standalone, works with fnm)
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME:$PNPM_HOME/bin:$PATH"

if ! command -v pnpm &>/dev/null; then
  curl -fsSL https://get.pnpm.io/install.sh | sh -
  # Installer appends to .zshrc but we already have PNPM_HOME in zsh-exports
  sed -i '' '/# pnpm/,/# pnpm end/d' "$HOME/.config/zsh/.zshrc"
else
  echo "pnpm already installed, skipping"
fi

# Stable V2 owns both opencode and opencode2; remove the old preview first.
echo "🤖 Installing OpenCode 2"
# Homebrew's opencode formula is the v1 line: it shadows the npm v2 binary on
# PATH while rejecting the v2 config schema. Remove it.
if brew list --versions opencode &>/dev/null; then
  brew uninstall --ignore-dependencies opencode
fi
npm uninstall --global --ignore-scripts @opencode-ai/cli
npm install --global --allow-scripts=@opencode/cli @opencode/cli

"$HOME/.local/bin/update-zsh-completions"
printf '\nOpen Tailscale.app and complete its attended sign-in/system-extension setup if needed.\n'
printf 'For Local + Box in Herdr, run ./macos/setup-box from a local Mac terminal.\n'
