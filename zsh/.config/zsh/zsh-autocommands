# starting directory on launch
# cd ~/dev/core-projects/

# Start/attach tmux only in a regular terminal. Herdr is already a terminal
# multiplexer, so starting tmux there would create an unnecessary nested session.
if [[ -z ${TMUX:-} && ${HERDR_ENV:-} != 1 ]]; then
  tmux new-session -A
fi

# ls after cd
# https://blog.meain.io/2019/automatically-ls-after-cd/
function list_all() {
  emulate -L zsh
  ls -a
}

if [[ ${chpwd_functions[(r)list_all]} != "list_all" ]];then
  chpwd_functions=(${chpwd_functions[@]} "list_all")
fi
