#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd -P)
HOME_PACKAGES=$REPO_ROOT/home

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  cat <<'EOF'
Usage: omarchy/install

Link my configuration into an Omarchy desktop. Omarchy keeps its packages,
shell, Node (mise) and services; my files replace Omarchy's copies of the same
files. Omarchy's defaults stay available in /usr/share/omarchy. Safe to rerun.
EOF
  exit 0
fi
[[ $# -eq 0 ]] || { printf 'error: unexpected arguments\n' >&2; exit 2; }
[[ $EUID -ne 0 ]] || { printf 'error: run as your normal user, not root\n' >&2; exit 1; }
[[ -d /usr/share/omarchy ]] || { printf 'error: Omarchy not found\n' >&2; exit 1; }

omarchy pkg add stow zsh zsh-autosuggestions zsh-syntax-highlighting
# Google Chrome instead of Omarchy's default Chromium (Omarchy installs and themes it).
command -v google-chrome-stable >/dev/null || omarchy install browser chrome
omarchy default browser chrome

# Linux UI text defaults larger than macOS; 11px suits the LG at 2560×1440 (GTK apps, Chrome UI and pages, shell).
omarchy display text size 11 >/dev/null

# My scripts need Bun and pnpm; Omarchy manages language tools with mise.
mise which bun >/dev/null 2>&1 || mise use --global bun@latest
mise which pnpm >/dev/null 2>&1 || mise use --global pnpm@latest

# Whole directories: replace Omarchy's seeded copy so none of its files load
# alongside mine.
owned_dirs=(.config/nvim .config/lazygit .local/share/worktree)
folded=(nvim lazygit scripts zsh)
# Single files merged into directories Omarchy or apps also use (~/.config/hypr keeps
# its machine-local monitors.lua, ~/.agents/skills keeps Omarchy's skills,
# ~/.config/herdr keeps Herdr's runtime state).
merged=(stow starship ghostty herdr omarchy agents)

for dir in "${owned_dirs[@]}"; do
  target=$HOME/$dir
  [[ -L $target ]] || rm -rf -- "$target"
done
for source in "$HOME_PACKAGES"/{scripts,zsh}/.local/bin/* "$HOME_PACKAGES"/zsh/.z*; do
  target=$HOME/${source#"$HOME_PACKAGES"/*/}
  [[ -L $target ]] || rm -f -- "$target"
done
for package in "${merged[@]}"; do
  while IFS= read -r -d '' source; do
    target=$HOME/${source#"$HOME_PACKAGES/$package/"}
    [[ -L $target ]] || rm -f -- "$target"
  done < <(find "$HOME_PACKAGES/$package" -type f -print0)
done

mkdir -p "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share"
stow --dir "$HOME_PACKAGES" --target "$HOME" --restow "${folded[@]}"
stow --dir "$HOME_PACKAGES" --target "$HOME" --no-folding --restow "${merged[@]}"

# LG UltraFine brightness (USB HID, no DDC/CI) for the brightness keys: lgbright from
# zhengnanli's tiled-display gist, pinned to the tested revision and checksum, plus a
# udev rule letting the logged-in user reach the display controls. Only with an LG attached.
if grep -qs '0000043E:00009A70' /sys/class/hidraw/*/device/uevent; then
  lgbright_url=https://gist.githubusercontent.com/zhengnanli/5ed6fb74d784efba55e5f7b64a47400a/raw/1b2993febc8a811f0f7331260808ede4db29569d/lgbright
  lgbright_sha=125fea67dd08ecca139a63f3c2b95a4d8c232bbcab2211d1c5576c9114db15aa
  if [[ $(sha256sum "$HOME/.local/bin/lgbright" 2>/dev/null) != "$lgbright_sha "* ]]; then
    tmp=$(mktemp)
    curl -fsSL "$lgbright_url" -o "$tmp"
    [[ $(sha256sum "$tmp") == "$lgbright_sha "* ]] || { rm -f "$tmp"; printf 'error: lgbright checksum mismatch\n' >&2; exit 1; }
    install -m755 "$tmp" "$HOME/.local/bin/lgbright"
    rm -f "$tmp"
  fi
  rule='KERNEL=="hidraw*", ATTRS{idVendor}=="043e", ATTRS{idProduct}=="9a70", TAG+="uaccess"'
  if ! grep -qsxF "$rule" /etc/udev/rules.d/70-lg-ultrafine.rules; then
    printf '# LG UltraFine display controls: let the logged-in user set brightness\n%s\n' "$rule" |
      sudo tee /etc/udev/rules.d/70-lg-ultrafine.rules >/dev/null
    sudo udevadm control --reload
    sudo udevadm trigger --subsystem-match=hidraw
  fi
fi

# Hex: local voice dictation (Linux beta), from its signed installer; the speech
# model runs on the device. 2.3.1 still needs the input group to see shortcuts;
# releases after it use Hyprland's shortcut portal and `hex dictation` commands.
omarchy pkg add openblas tinyxxd gtk-layer-shell
if [[ ! -x $HOME/.local/bin/hex ]]; then
  hex_tmp=$(mktemp -d)
  curl --proto '=https' --tlsv1.2 -fsSL https://anoma.ly/hex/files/install-linux.sh -o "$hex_tmp/install-linux.sh"
  sh "$hex_tmp/install-linux.sh"
  rm -rf "$hex_tmp"
fi
"$HOME/.local/bin/hex" model status | grep -q '^installed' || "$HOME/.local/bin/hex" model install

# Dependencies resolve from the linked source paths inside this repository.
mise exec -- bun install --frozen-lockfile --cwd "$HOME_PACKAGES/scripts/.local/share/worktree"

"$HOME/.local/bin/update-zsh-completions"
[[ $(getent passwd "$USER" | cut -d: -f7) == */zsh ]] || chsh -s /usr/bin/zsh

# Workflow defaults; name and email come from the Omarchy installer.
git config --global core.editor nvim
git config --global core.excludesFile "$HOME_PACKAGES/git/.config/git/ignore"
git config --global pull.ff only
git config --global init.defaultBranch main
git config --global push.autoSetupRemote true

systemctl --user daemon-reload
if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  hyprctl reload >/dev/null
fi
echo "✅ Configuration linked"
