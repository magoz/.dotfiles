#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd -P)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd -P)
HOME_PACKAGES=$REPO_ROOT/home

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
  printf 'Usage: arch/stow\nApply portable home configuration only; preserve desktop and machine services.\n'
  exit 0
fi
[[ $# -eq 0 ]] || { printf 'error: unexpected arguments\n' >&2; exit 2; }

# Git contains macOS credential helpers; Herdr contains Box-specific settings.
# Desktop/session configuration stays with the distribution (including Omarchy).
packages=(stow starship nvim zsh lazygit opencode agents pi scripts)

removed_paths=()
removed_links=()
stow_applied=0
restore_migrations() {
  local status=$? index
  if (( ! stow_applied )); then
    for index in "${!removed_paths[@]}"; do
      if [[ ! -e ${removed_paths[index]} && ! -L ${removed_paths[index]} ]]; then
        ln -s -- "${removed_links[index]}" "${removed_paths[index]}" ||
          printf 'error: could not restore migrated link: %s\n' "${removed_paths[index]}" >&2
      fi
    done
  fi
  return "$status"
}
trap restore_migrations EXIT

remove_migrated_link() {
  removed_paths+=("$1")
  removed_links+=("$(readlink "$1")")
  rm -- "$1"
}

normalize_path() {
  local path=$1
  local base=$2
  local part index
  local -a components normalized=()

  [[ $path == /* ]] || path=$base/$path
  IFS=/ read -r -a components <<<"$path"
  for part in "${components[@]}"; do
    case $part in
    '' | .) ;;
    ..)
      if ((${#normalized[@]} > 0)); then
        index=$((${#normalized[@]} - 1))
        unset "normalized[$index]"
      fi
      ;;
    *) normalized[${#normalized[@]}]=$part ;;
    esac
  done
  (
    IFS=/
    printf '/%s' "${normalized[*]}"
  )
}

migrate_legacy_node() {
  local source_node=$1
  local target_node=$2
  local package=$3
  local link candidate child relative
  local legacy_root=$REPO_ROOT/$package

  if [[ -L $target_node ]]; then
    link=$(readlink "$target_node")
    candidate=$(normalize_path "$link" "$(dirname "$target_node")")
    case $candidate in
    "$legacy_root" | "$legacy_root"/*)
      remove_migrated_link "$target_node"
      ;;
    esac
    return 0
  fi

  git -C "$REPO_ROOT" check-ignore --quiet -- "$source_node" && return 0
  [[ -d $source_node && -d $target_node ]] || return 0
  while IFS= read -r -d '' child; do
    relative=${child#"$source_node"/}
    migrate_legacy_node "$child" "$target_node/$relative" "$package"
  done < <(find "$source_node" -mindepth 1 -maxdepth 1 -print0)
}

echo "🔗 Running Stow for Arch..."

# Keep shared XDG parents as real directories so runtime state created by one
# tool cannot be written through a folded Stow package directory.
mkdir -p "$HOME/.config" "$HOME/.local/bin" "$HOME/.local/share"

for package in "${packages[@]}"; do
  migrate_legacy_node "$HOME_PACKAGES/$package" "$HOME" "$package"
done

# Stow refuses to adopt an absolute symlink, even when it already points to
# this package. Remove that legacy link so Stow can recreate and own it.
if [[ -L $HOME/.agents ]] &&
  [[ $(readlink "$HOME/.agents") == "$HOME_PACKAGES/agents/.agents" ]]; then
  remove_migrated_link "$HOME/.agents"
fi

mkdir -p "$HOME/.pi/agent"

# Check the complete selection before applying any package. Never adopt or
# delete unrelated configuration; let Stow report conflicts for manual review.
stow --dir "$HOME_PACKAGES" --target "$HOME" --simulate --restow "${packages[@]}"
stow --dir "$HOME_PACKAGES" --target "$HOME" --restow "${packages[@]}"
stow_applied=1

"$HOME/.local/bin/update-zsh-completions"
echo "✅ Stow complete"
